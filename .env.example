# Free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: pick a different model (any tool-calling model; ":free" ones cost nothing)
# LLM_MODEL=poolside/laguna-s-2.1:free
# Optional: use another OpenAI-compatible provider (Groq, Ollama, Gemini...)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: uncomment all three to enable Langfuse tracing (https://cloud.langfuse.com -> project settings -> API keys).
# Leave them commented out to run without tracing; placeholder values would switch tracing on with invalid keys.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
